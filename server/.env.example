# Copy to .env and adjust. Never commit .env (SRS Section 5.6).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://bbtms:bbtms@localhost:5432/bbtms

# Long random string, at least 32 characters
SESSION_SECRET=change-me-to-a-long-random-string-1234567890

# 32-byte key as 64 hex chars, for AES-256 passport encryption (NFR-SEC-03)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=paste-the-team-key-here

# Mailpit in development
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Beyond Borders <no-reply@bbtravel.test>"

CLIENT_URL=http://localhost:5173

# Staging only: lets testers move the clock (SRS Section 9.2). Leave false in production.
ALLOW_CLOCK_CONTROL=true
